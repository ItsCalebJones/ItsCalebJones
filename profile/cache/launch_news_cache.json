[{"id": 39903, "title": "A team of teams like never before: rehearsing a unique launch at ESA mission control", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/Enabling_Support/Operations/A_team_of_teams_like_never_before_rehearsing_a_unique_launch_at_ESA_mission_control", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/images/2026/09/teams_at_esoc_during_esa_s_flex_and_copernicus_sentinel-3c_launch_and_early_orbit_leop_simulations/27464737-3-eng-GB/Teams_at_ESOC_during_ESA_s_FLEX_and_Copernicus_Sentinel-3C_launch_and_early_orbit_LEOP_simulations_card_full.png", "news_site": "ESA", "summary": "On 15 September, two spacecraft will leave Earth together aboard the same launcher from Europe\u2019s spaceport in Kourou: FLEX, ESA\u2019s photosynthesis mission, and Sentinel-3C, Copernicus\u2019 newest satellite monitoring Earth\u2019s oceans, land, ice and atmosphere.", "published_at": "2026-09-11T08:00:00Z", "updated_at": "2026-09-13T06:36:05.429995Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39886, "title": "pVega-C flight VV30 with FLEX and Sentinel-3C", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/ESA_Multimedia/Images/2026/09/pVega-C_flight_VV30_with_FLEX_and_Sentinel-3C", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/images/2026/09/pvega-c_flight_vv30_with_flex_and_sentinel-3c/27459948-1-eng-GB/pVega-C_flight_VV30_with_FLEX_and_Sentinel-3C_card_full.png", "news_site": "ESA", "summary": "From the ESA Blogs.", "published_at": "2026-09-09T10:13:00Z", "updated_at": "2026-09-10T11:20:25.856519Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39872, "title": "Vega-C flight VV30 with FLEX and Sentinel-3C", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/ESA_Multimedia/Images/2026/09/Vega-C_flight_VV30_with_FLEX_and_Sentinel-3C", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/images/2026/09/vega-c_flight_vv30_with_flex_and_sentinel-3c/27459948-1-eng-GB/Vega-C_flight_VV30_with_FLEX_and_Sentinel-3C_card_full.png", "news_site": "ESA", "summary": "From the ESA Blogs.", "published_at": "2026-09-09T10:13:00Z", "updated_at": "2026-09-10T11:12:03.919642Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39874, "title": "Watch: FLEX and Sentinel-3C launch on Vega-C", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/Applications/Observing_the_Earth/Watch_FLEX_and_Sentinel-3C_launch_on_Vega-C", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/images/2026/09/vega-c_fairing_opens_to_reveal_sentinel-3c_and_flex/27460042-1-eng-GB/Vega-C_fairing_opens_to_reveal_Sentinel-3C_and_FLEX_card_full.jpg", "news_site": "ESA", "summary": "The European Space Agency\u2019s FLEX satellite and the Copernicus Sentinel-3C satellite are scheduled to launch together aboard a Vega-C rocket on 15 September at 03:21 CEST (14 September at 22:21 local time). Watch the VV30 launch live from Europe\u2019s Spaceport in French Guiana, with coverage starting at 02:50 CEST.", "published_at": "2026-09-09T09:56:00Z", "updated_at": "2026-09-10T11:11:44.248653Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39836, "title": "Media briefing ahead of FLEX and Sentinel-3C launch", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/ESA_Multimedia/Videos/2026/09/Media_briefing_ahead_of_FLEX_and_Sentinel-3C_launch", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/videos/2026/09/media_briefing_ahead_of_flex_and_sentinel-3c_launch/27445744-3-eng-GB/Media_briefing_ahead_of_FLEX_and_Sentinel-3C_launch_card_full.png", "news_site": "ESA", "summary": "On 4 September 2026, media representatives joined an online briefing ahead of the launch of ESA\u2019s FLEX and the Copernicus Sentinel-3C satellites.", "published_at": "2026-09-04T14:00:00Z", "updated_at": "2026-09-04T18:02:15.799380Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39815, "title": "FLEX and Sentinel-3C sealed within Vega-C fairing", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/Applications/Observing_the_Earth/FLEX_and_Sentinel-3C_sealed_within_Vega-C_fairing", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/images/2026/09/flex_and_sentinel-3c_being_sealed_from_view/27447417-4-eng-GB/FLEX_and_Sentinel-3C_being_sealed_from_view_card_full.jpg", "news_site": "ESA", "summary": "At Europe\u2019s Spaceport in French Guiana, preparations for one of the year\u2019s most anticipated Earth-observation launches are entering their final stages.", "published_at": "2026-09-02T16:08:00Z", "updated_at": "2026-09-03T13:13:08.909575Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39870, "title": "Sentinel-3C positioned on the top of the Vespa adapter", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/ESA_Multimedia/Images/2026/09/Sentinel-3C_positioned_on_the_top_of_the_Vespa_adapter", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/images/2026/09/sentinel-3c_positioned_on_the_top_of_the_vespa_adapter/27451566-1-eng-GB/Sentinel-3C_positioned_on_the_top_of_the_Vespa_adapter_card_full.jpg", "news_site": "ESA", "summary": "From the ESA Blogs.", "published_at": "2026-09-02T08:30:00Z", "updated_at": "2026-09-09T09:12:49.513471Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39596, "title": "ESA\u2019s photosynthesis satellite fuelled", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/Applications/Observing_the_Earth/FutureEO/FLEX/ESA_s_photosynthesis_satellite_fuelled", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/images/2026/08/safey_is_paramount_when_fuelling_a_satellite/27423664-1-eng-GB/Safey_is_paramount_when_fuelling_a_satellite_card_full.jpg", "news_site": "ESA", "summary": "Europe\u2019s newest eye on the health of Earth\u2019s vegetation has taken another crucial step towards orbit \u2013 the European Space Agency\u2019s FLEX satellite has been fuelled at Europe\u2019s Spaceport in French Guiana ahead of its planned launch on 15 September at 03:21 CEST (14 September at 22:21 local time).", "published_at": "2026-08-20T07:00:00Z", "updated_at": "2026-08-31T14:39:48.485069Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39022, "title": "FLEX and Sentinel-3C arrive at Europe\u2019s Spaceport", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/Applications/Observing_the_Earth/FLEX_and_Sentinel-3C_arrive_at_Europe_s_Spaceport", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/images/2026/07/flex_and_sentinel-3_head_to_launch_site/27379827-1-eng-GB/FLEX_and_Sentinel-3_head_to_launch_site_card_full.jpg", "news_site": "ESA", "summary": "With liftoff scheduled for September, excitement is building at Europe\u2019s Spaceport in French Guiana as two cutting-edge Earth observation satellites, FLEX and Copernicus Sentinel-3C, have arrived to begin their launch campaigns.", "published_at": "2026-07-16T07:00:00Z", "updated_at": "2026-07-20T14:21:31.247765Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 37562, "title": "Three ESA-built satellites on show in France", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/Applications/Observing_the_Earth/Three_ESA-built_satellites_on_show_in_France", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/images/2026/04/flex_sentinel-3c_and_mtg-i2_on_show_at_tas_cleanrooms/27207480-1-eng-GB/FLEX_Sentinel-3C_and_MTG-I2_on_show_at_TAS_cleanrooms_card_full.jpg", "news_site": "ESA", "summary": "Three Earth observation satellites, developed by the European Space Agency (ESA) with European partners, and due to launch later this year, have completed their functional and environmental tests and are ready to travel to the European spaceport in French Guiana. But first, journalists were invited to have one last look.", "published_at": "2026-04-16T12:00:00Z", "updated_at": "2026-04-16T12:36:43.782288Z", "featured": false, "launches": [{"launch_id": "a57aed97-b94f-42e1-905e-9421dbd96ac8", "provider": "Launch Library 2"}, {"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}]